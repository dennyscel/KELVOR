      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 432.908,
      "end": 435.668,
      "pause_end": 436.049,
      "text": "para ver como ele os chamaria."
    },
    {
      "i": 86,
      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 436.049,
      "end": 440.945,
      "pause_end": 441.434,
      "text": "Leão. Águia. Cervo. Elefante."
    },
    {
      "i": 87,
      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 441.434,
      "end": 446.402,
      "pause_end": 446.783,
      "text": "E o nome que o homem deu a cada ser vivente, esse foi o seu nome."
    },
    {
      "i": 88,
      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 446.783,
      "end": 450.743,
      "pause_end": 451.178,
      "text": "Um a um, eles passaram, e cada um tinha o seu par."
    },
    {
      "i": 89,
      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 451.178,
      "end": 455.33,
      "pause_end": 455.819,
      "text": "Mas para o homem não se achava ninguém que lhe correspondesse."
    },
    {
      "i": 90,
      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 455.819,
      "end": 460.331,
      "pause_end": 461.147,
      "text": "Ele estava cercado de vida e, ainda assim, estava só."
