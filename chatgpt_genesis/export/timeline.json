      "scene": 13,
      "scene_id": "bencao",
      "cap": "A bênção",
      "day": "Sexto dia",
      "start": 523.784,
      "end": 528.824,
      "pause_end": 529.15,
      "text": "Cuidai dos peixes do mar, das aves do céu e de todo ser vivente."
    },
    {
      "i": 104,
      "scene": 13,
      "scene_id": "bencao",
      "cap": "A bênção",
      "day": "Sexto dia",
      "start": 529.15,
      "end": 535.582,
      "pause_end": 535.963,
      "text": "Eis que vos tenho dado toda erva que dá semente e todo fruto das árvores para o vosso sustento."
