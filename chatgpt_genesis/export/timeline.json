      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 495.305,
      "end": 501.257,
      "pause_end": 501.692,
      "text": "Então disse: esta, afinal, é osso dos meus ossos e carne da minha carne."
