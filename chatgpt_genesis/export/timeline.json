      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 501.692,
      "end": 505.7,
      "pause_end": 506.298,
      "text": "Ela será chamada mulher, porque do homem foi tomada."
