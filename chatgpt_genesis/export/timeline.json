      "scene_id": "epilogo",
      "cap": "Era muito bom",
      "day": null,
      "start": 579.782,
      "end": 585.23,
      "pause_end": 585.611,
      "text": "Da terra brotou a vida. E da vida, o homem, feito à imagem de Deus."
