    {
      "i": 97,
      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 491.286,
      "end": 494.598,
      "pause_end": 495.305,
      "text": "Adão despertou. E a viu."
