      "cap": "A criação da mulher",
      "day": null,
      "start": 474.317,
      "end": 478.565,
      "pause_end": 478.946,
      "text": "Tomou uma de suas costelas e fechou a carne em seu lugar."
    },
    {
      "i": 94,
      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 478.946,
      "end": 482.978,
      "pause_end": 483.413,
      "text": "E da costela que tirou do homem, Deus formou a mulher."
    },
    {
      "i": 95,
      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 483.413,
      "end": 487.781,
      "pause_end": 488.325,
