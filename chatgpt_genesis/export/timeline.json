      "scene": 14,
      "scene_id": "descanso",
      "cap": "Sétimo dia: o descanso",
      "day": "Sétimo dia",
      "start": 550.073,
      "end": 554.417,
      "pause_end": 554.906,
      "text": "E no sétimo dia, Deus terminou a obra que havia feito."
