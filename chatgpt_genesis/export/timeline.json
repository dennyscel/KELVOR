    {
      "i": 105,
      "scene": 13,
      "scene_id": "bencao",
      "cap": "A bênção",
      "day": "Sexto dia",
      "start": 535.963,
      "end": 543.715,
      "pause_end": 544.694,
      "text": "E viu Deus tudo quanto tinha feito, e eis que era muito bom. E houve tarde, e houve manhã: o sexto dia."
