      "scene": 13,
      "scene_id": "bencao",
      "cap": "A bênção",
      "day": "Sexto dia",
      "start": 513.063,
      "end": 517.191,
      "pause_end": 517.626,
      "text": "Entre eles não havia medo, nem culpa, nem vergonha."
