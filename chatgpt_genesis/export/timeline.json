      "day": "Sétimo dia",
      "start": 558.359,
      "end": 562.343,
      "pause_end": 562.832,
      "text": "Não por cansaço, mas porque tudo estava completo."
    },
    {
      "i": 110,
      "scene": 14,
      "scene_id": "descanso",
      "cap": "Sétimo dia: o descanso",
      "day": "Sétimo dia",
      "start": 562.832,
      "end": 569.264,
      "pause_end": 569.753,
      "text": "O vento passou pelas árvores, os rios seguiram o seu curso, e a criação respirou em paz."
