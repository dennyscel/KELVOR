      "scene": 13,
      "scene_id": "bencao",
      "cap": "A bênção",
      "day": "Sexto dia",
      "start": 517.626,
      "end": 523.458,
      "pause_end": 523.784,
      "text": "E Deus os abençoou, e disse: frutificai, multiplicai-vos e enchei a terra."
