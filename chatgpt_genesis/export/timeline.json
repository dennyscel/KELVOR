      "scene": 13,
      "scene_id": "bencao",
      "cap": "A bênção",
      "day": "Sexto dia",
      "start": 506.298,
      "end": 512.682,
      "pause_end": 513.063,
      "text": "Por isso o homem deixa pai e mãe, se une à sua mulher, e os dois se tornam uma só carne."
