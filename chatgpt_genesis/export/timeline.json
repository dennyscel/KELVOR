      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 469.34,
      "end": 473.828,
      "pause_end": 474.317,
      "text": "E fez cair um sono profundo sobre o homem, e ele adormeceu."
