    {
      "i": 91,
      "scene": 12,
      "scene_id": "mulher",
      "cap": "A criação da mulher",
      "day": null,
      "start": 461.147,
      "end": 468.851,
      "pause_end": 469.34,
      "text": "Então disse o Senhor Deus: não é bom que o homem esteja só. Farei para ele uma companheira que lhe corresponda."
