      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 418.148,
      "end": 426.284,
      "pause_end": 426.937,
      "text": "Mas da árvore do conhecimento do bem e do mal não comerás, porque no dia em que dela comeres, certamente morrerás."
    },
    {
      "i": 84,
      "scene": 11,
      "scene_id": "nomes",
      "cap": "Adão dá nome aos animais",
      "day": null,
      "start": 426.937,
      "end": 432.745,
      "pause_end": 432.908,
      "text": "Então Deus trouxe ao homem todos os animais do campo e todas as aves do céu,"
    },
    {
