      "scene": 14,
      "scene_id": "descanso",
      "cap": "Sétimo dia: o descanso",
      "day": "Sétimo dia",
      "start": 569.753,
      "end": 573.833,
      "pause_end": 574.649,
      "text": "E Deus abençoou o sétimo dia, e o santificou."
