{
  "duration": 600,
  "voice": "pt-BR-FranciscaNeural",
  "cues": [
    {
      "i": 1,
      "scene": 0,
      "scene_id": "trevas",
      "cap": "No princípio",
      "day": null,
      "start": 2.2,
      "end": 8.632,
      "pause_end": 9.176,
      "text": "No princípio, antes do tempo, antes da primeira manhã, havia somente Deus."
    },
    {
      "i": 2,
      "scene": 0,
      "scene_id": "trevas",
      "cap": "No princípio",
      "day": null,
      "start": 9.176,
      "end": 13.232,
      "pause_end": 13.885,
      "text": "E no princípio, Deus criou os céus e a terra."
    },
    {
      "i": 3,
      "scene": 0,
      "scene_id": "trevas",
      "cap": "No princípio",
      "day": null,
      "start": 13.885,
      "end": 17.317,
      "pause_end": 17.806,
      "text": "A terra, porém, era sem forma e vazia."
    },
    {
      "i": 4,
      "scene": 0,
      "scene_id": "trevas",
      "cap": "No princípio",
      "day": null,
      "start": 17.806,
      "end": 23.35,
      "pause_end": 24.003,
      "text": "Trevas cobriam a face do abismo. Não havia som, nem cor, nem vida."
    },
    {
      "i": 5,
      "scene": 0,
      "scene_id": "trevas",
      "cap": "No princípio",
      "day": null,
      "start": 24.003,
      "end": 28.395,
      "pause_end": 28.884,
      "text": "Mas o Espírito de Deus se movia sobre a face das águas."
    },
    {
      "i": 6,
      "scene": 0,
      "scene_id": "trevas",
      "cap": "No princípio",
      "day": null,
      "start": 28.884,
      "end": 34.86,
      "pause_end": 35.73,
      "text": "Como um sopro suave, pairando sobre o silêncio, esperando o momento da palavra."
    },
    {
      "i": 7,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 35.73,
      "end": 38.178,
      "pause_end": 39.157,
      "text": "Então Deus falou."
    },
    {
      "i": 8,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 39.157,
      "end": 41.245,
      "pause_end": 41.517,
      "text": "Haja luz."
    },
    {
      "i": 9,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 41.517,
      "end": 43.605,
      "pause_end": 44.475,
      "text": "E houve luz."
    },
    {
      "i": 10,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 44.475,
      "end": 49.683,
      "pause_end": 50.118,
      "text": "A claridade rompeu as trevas, como uma aurora que jamais havia existido."
    },
    {
      "i": 11,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 50.118,
      "end": 52.878,
      "pause_end": 53.313,
      "text": "E Deus viu que a luz era boa."
    },
    {
      "i": 12,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 53.313,
      "end": 56.361,
      "pause_end": 56.742,
      "text": "Então separou a luz das trevas."
    },
    {
      "i": 13,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 56.742,
      "end": 61.614,
      "pause_end": 62.103,
      "text": "À luz, Deus chamou dia. E às trevas, chamou noite."
    },
    {
      "i": 14,
      "scene": 1,
      "scene_id": "luz",
      "cap": "Primeiro dia: a luz",
      "day": "Primeiro dia",
      "start": 62.103,
      "end": 66.063,
      "pause_end": 67.042,
      "text": "E houve tarde, e houve manhã: o primeiro dia."
    },
    {
      "i": 15,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 67.042,
      "end": 73.81,
      "pause_end": 74.245,
      "text": "E disse Deus: haja uma expansão no meio das águas, e haja separação entre águas e águas."
    },
    {
      "i": 16,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 74.245,
      "end": 76.789,
      "pause_end": 77.224,
      "text": "E as águas obedeceram."
    },
    {
      "i": 17,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 77.224,
      "end": 82.912,
      "pause_end": 83.347,
      "text": "Parte delas subiu ao alto, como um véu de vapor, e parte permaneceu embaixo."
    },
    {
      "i": 18,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 83.347,
      "end": 88.483,
      "pause_end": 89.081,
      "text": "Entre elas, Deus estendeu o firmamento, como uma abóbada sobre o mundo."
    },
    {
      "i": 19,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 89.081,
      "end": 92.465,
      "pause_end": 92.9,
      "text": "E ao firmamento, Deus chamou céus."
    },
    {
      "i": 20,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 92.9,
      "end": 99.188,
      "pause_end": 99.677,
      "text": "Nuvens se formaram, o vento soprou pela primeira vez, e o horizonte ganhou profundidade."
    },
    {
      "i": 21,
      "scene": 2,
      "scene_id": "firmamento",
      "cap": "Segundo dia: o firmamento",
      "day": "Segundo dia",
      "start": 99.677,
      "end": 103.685,
      "pause_end": 104.664,
      "text": "E houve tarde, e houve manhã: o segundo dia."
    },
    {
      "i": 22,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 104.664,
      "end": 111.456,
      "pause_end": 111.782,
      "text": "Disse Deus: ajuntem-se as águas debaixo dos céus num só lugar, e apareça a porção seca."
    },
    {
      "i": 23,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 111.782,
      "end": 113.87,
      "pause_end": 114.359,
      "text": "E assim foi."
    },
    {
      "i": 24,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 114.359,
      "end": 117.839,
      "pause_end": 118.22,
      "text": "Do fundo das águas, a rocha se levantou."
    },
    {
      "i": 25,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 118.22,
      "end": 124.244,
      "pause_end": 124.679,
      "text": "Montanhas romperam a superfície, e a água escorreu de seus ombros em cascatas."
    },
    {
      "i": 26,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 124.679,
      "end": 129.791,
      "pause_end": 130.226,
      "text": "Vales se abriram, e rios começaram a encontrar o seu caminho até o mar."
    },
    {
      "i": 27,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 130.226,
      "end": 136.178,
      "pause_end": 136.613,
      "text": "À porção seca, Deus chamou terra. Ao ajuntamento das águas, chamou mares."
    },
    {
      "i": 28,
      "scene": 3,
      "scene_id": "terra",
      "cap": "Terceiro dia: a terra seca",
      "day": null,
      "start": 136.613,
      "end": 138.917,
      "pause_end": 139.57,
      "text": "E Deus viu que era bom."
    },
    {
      "i": 29,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 139.57,
      "end": 146.17,
      "pause_end": 146.496,
      "text": "Então disse Deus: produza a terra relva, ervas que deem semente e árvores que deem fruto."
    },
    {
      "i": 30,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 146.496,
      "end": 148.8,
      "pause_end": 149.235,
      "text": "E o chão nu respondeu."
    },
    {
      "i": 31,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 149.235,
      "end": 154.659,
      "pause_end": 155.04,
      "text": "Brotos romperam a terra, e o verde se espalhou pelas colinas como uma onda."
    },
    {
      "i": 32,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 155.04,
      "end": 160.008,
      "pause_end": 160.389,
      "text": "Troncos subiram, galhos se abriram, e as folhas se voltaram para a luz."
    },
    {
      "i": 33,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 160.389,
      "end": 164.973,
      "pause_end": 165.354,
      "text": "Flores desabrocharam em cores que ninguém jamais havia visto."
    },
    {
      "i": 34,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 165.354,
      "end": 171.282,
      "pause_end": 171.717,
      "text": "Frutos pesaram nos galhos, cada um trazendo em si a semente da próxima árvore."
    },
    {
      "i": 35,
      "scene": 4,
      "scene_id": "plantas",
      "cap": "Terceiro dia: a vegetação",
      "day": "Terceiro dia",
      "start": 171.717,
      "end": 177.405,
      "pause_end": 178.384,
      "text": "E Deus viu que era bom. E houve tarde, e houve manhã: o terceiro dia."
    },
    {
      "i": 36,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 178.384,
      "end": 185.608,
      "pause_end": 185.934,
      "text": "Disse Deus: haja luminares no firmamento dos céus, para fazer separação entre o dia e a noite."
    },
    {
      "i": 37,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 185.934,
      "end": 191.07,
      "pause_end": 191.451,
      "text": "Que sirvam de sinais, para marcar as estações, os dias e os anos."
    },
    {
      "i": 38,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 191.451,
      "end": 195.771,
      "pause_end": 196.152,
      "text": "Então o grande luminar se acendeu, para governar o dia."
    },
    {
      "i": 39,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 196.152,
      "end": 201.408,
      "pause_end": 201.843,
      "text": "Seu calor aqueceu a terra, e sua luz dourou os mares e as montanhas."
    },
    {
      "i": 40,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 201.843,
      "end": 205.875,
      "pause_end": 206.31,
      "text": "E o luminar menor foi posto para governar a noite."
    },
    {
      "i": 41,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 206.31,
      "end": 209.19,
      "pause_end": 209.625,
      "text": "Deus fez também as estrelas."
    },
    {
      "i": 42,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 209.625,
      "end": 215.145,
      "pause_end": 215.58,
      "text": "Milhares, milhões delas, espalhadas pelo firmamento como poeira de luz."
    },
    {
      "i": 43,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 215.58,
      "end": 220.308,
      "pause_end": 220.743,
      "text": "E o céu passou a girar como um grande relógio, contando os tempos."
    },
    {
      "i": 44,
      "scene": 5,
      "scene_id": "luminares",
      "cap": "Quarto dia: os luminares",
      "day": "Quarto dia",
      "start": 220.743,
      "end": 224.727,
      "pause_end": 225.706,
      "text": "E houve tarde, e houve manhã: o quarto dia."
    },
    {
      "i": 45,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 225.706,
      "end": 230.002,
      "pause_end": 230.328,
      "text": "Disse Deus: povoem-se as águas de seres viventes."
    },
    {
      "i": 46,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 230.328,
      "end": 234.24,
      "pause_end": 234.566,
      "text": "E o mar, que era silêncio, encheu-se de movimento."
    },
    {
      "i": 47,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 234.566,
      "end": 239.894,
      "pause_end": 240.22,
      "text": "Pequenos peixes surgiram aos milhares, girando em cardumes prateados."
    },
    {
      "i": 48,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 240.22,
      "end": 244.78,
      "pause_end": 245.106,
      "text": "Corais se abriram em cores, e algas dançaram nas correntes."
    },
    {
      "i": 49,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 245.106,
      "end": 248.994,
      "pause_end": 249.375,
      "text": "Tartarugas deslizaram entre os raios de luz."
    },
    {
      "i": 50,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 249.375,
      "end": 252.807,
      "pause_end": 253.188,
      "text": "E Deus criou os grandes animais marinhos."
    },
    {
      "i": 51,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 253.188,
      "end": 258.756,
      "pause_end": 259.245,
      "text": "Baleias imensas cruzaram as profundezas, e o seu canto ecoou pelo oceano."
    },
    {
      "i": 52,
      "scene": 6,
      "scene_id": "mar",
      "cap": "Quinto dia: os mares",
      "day": null,
      "start": 259.245,
      "end": 263.373,
      "pause_end": 263.808,
      "text": "Golfinhos saltaram sobre as ondas, brincando na luz."
    },
    {
      "i": 53,
      "scene": 7,
      "scene_id": "aves",
      "cap": "Quinto dia: as aves",
      "day": "Quinto dia",
      "start": 263.808,
      "end": 268.872,
      "pause_end": 269.198,
      "text": "E disse Deus: voem as aves sobre a terra, pela expansão dos céus."
    },
    {
      "i": 54,
      "scene": 7,
      "scene_id": "aves",
      "cap": "Quinto dia: as aves",
      "day": "Quinto dia",
      "start": 269.198,
      "end": 272.246,
      "pause_end": 272.627,
      "text": "Asas se abriram pela primeira vez."
    },
    {
      "i": 55,
      "scene": 7,
      "scene_id": "aves",
      "cap": "Quinto dia: as aves",
      "day": "Quinto dia",
      "start": 272.627,
      "end": 277.019,
      "pause_end": 277.345,
      "text": "Bandos riscaram o céu sobre praias, rios e montanhas."
    },
    {
      "i": 56,
      "scene": 7,
      "scene_id": "aves",
      "cap": "Quinto dia: as aves",
      "day": "Quinto dia",
      "start": 277.345,
      "end": 282.889,
      "pause_end": 283.27,
      "text": "Uma águia subiu nas correntes de ar, mais alto do que qualquer outra criatura."
    },
    {
      "i": 57,
      "scene": 7,
      "scene_id": "aves",
      "cap": "Quinto dia: as aves",
      "day": "Quinto dia",
      "start": 283.27,
      "end": 291.334,
      "pause_end": 292.313,
      "text": "Deus os abençoou, dizendo: frutificai e multiplicai-vos. E houve tarde, e houve manhã: o quinto dia."
    },
    {
      "i": 58,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 292.313,
      "end": 297.929,
      "pause_end": 298.255,
      "text": "Então disse Deus: produza a terra seres viventes, conforme a sua espécie."
    },
    {
      "i": 59,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 298.255,
      "end": 301.039,
      "pause_end": 301.42,
      "text": "E a terra estremeceu de vida."
    },
    {
      "i": 60,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 301.42,
      "end": 306.94,
      "pause_end": 307.266,
      "text": "Manadas surgiram nas planícies, e o som dos cascos ecoou pelos vales."
    },
    {
      "i": 61,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 307.266,
      "end": 312.066,
      "pause_end": 312.392,
      "text": "Elefantes caminharam devagar, sacudindo a poeira das costas."
    },
    {
      "i": 62,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 312.392,
      "end": 316.568,
      "pause_end": 316.894,
      "text": "Girafas ergueram o pescoço até a copa das árvores."
    },
    {
      "i": 63,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 316.894,
      "end": 322.726,
      "pause_end": 323.052,
      "text": "Coelhos correram entre as raízes, e pequenos animais encheram cada canto do campo."
    },
    {
      "i": 64,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 323.052,
      "end": 328.692,
      "pause_end": 329.073,
      "text": "Um leão atravessou a relva, e ao seu lado os filhotes brincavam, sem medo algum."
    },
    {
      "i": 65,
      "scene": 8,
      "scene_id": "animais",
      "cap": "Sexto dia: os animais",
      "day": null,
      "start": 329.073,
      "end": 331.377,
      "pause_end": 332.03,
      "text": "E Deus viu que era bom."
    },
    {
      "i": 66,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 332.83,
      "end": 339.454,
      "pause_end": 339.998,
      "text": "Então disse Deus: façamos o homem à nossa imagem, conforme a nossa semelhança."
    },
    {
      "i": 67,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 339.998,
      "end": 343.67,
      "pause_end": 344.051,
      "text": "E o Senhor Deus formou o homem do pó da terra."
    },
    {
      "i": 68,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 344.051,
      "end": 348.275,
      "pause_end": 348.656,
      "text": "O pó se ergueu, girou no ar, e começou a tomar forma."
    },
    {
      "i": 69,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 348.656,
      "end": 352.664,
      "pause_end": 353.208,
      "text": "Ombros, braços, mãos. Um rosto."
    },
    {
      "i": 70,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 353.208,
      "end": 356.136,
      "pause_end": 357.006,
      "text": "Mas ainda não havia vida."
    },
    {
      "i": 71,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 357.006,
      "end": 361.542,
      "pause_end": 362.086,
      "text": "Então Deus soprou em suas narinas o fôlego da vida."
    },
    {
      "i": 72,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 362.086,
      "end": 364.222,
      "pause_end": 364.875,
      "text": "O peito se elevou."
    },
    {
      "i": 73,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 364.875,
      "end": 368.019,
      "pause_end": 368.563,
      "text": "E o homem passou a ser alma vivente."
    },
    {
      "i": 74,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 368.563,
      "end": 372.883,
      "pause_end": 373.372,
      "text": "Ele abriu os olhos, e a primeira coisa que viu foi a luz."
    },
    {
      "i": 75,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 373.372,
      "end": 378.94,
      "pause_end": 379.375,
      "text": "Sentiu o vento no rosto, a terra sob as mãos, e ouviu a própria respiração."
    },
    {
      "i": 76,
      "scene": 9,
      "scene_id": "homem",
      "cap": "Sexto dia: o homem",
      "day": null,
      "start": 379.375,
      "end": 384.103,
      "pause_end": 384.756,
      "text": "Então se levantou, e contemplou um mundo inteiro preparado para ele."
    },
    {
      "i": 77,
      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 384.756,
      "end": 389.388,
      "pause_end": 389.714,
      "text": "E o Senhor Deus plantou um jardim no Éden, do lado do oriente."
    },
    {
      "i": 78,
      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 389.714,
      "end": 394.826,
      "pause_end": 395.152,
      "text": "Ali fez brotar toda árvore agradável aos olhos e boa para alimento."
    },
    {
      "i": 79,
      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 395.152,
      "end": 401.2,
      "pause_end": 401.635,
      "text": "No meio do jardim estavam a árvore da vida e a árvore do conhecimento do bem e do mal."
    },
    {
      "i": 80,
      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 401.635,
      "end": 407.707,
      "pause_end": 408.088,
      "text": "Um rio saía do Éden para regar o jardim, e dali se dividia em quatro braços."
    },
    {
      "i": 81,
      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 408.088,
      "end": 412.456,
      "pause_end": 412.782,
      "text": "Deus colocou o homem no jardim, para o cultivar e o guardar."
    },
    {
      "i": 82,
      "scene": 10,
      "scene_id": "eden",
      "cap": "O jardim do Éden",
      "day": null,
      "start": 412.782,
      "end": 417.822,
      "pause_end": 418.148,
      "text": "E lhe deu uma ordem: de toda árvore do jardim comerás livremente."
    },
    {
